# PiClaw local-only pi authority.
#
# Goal: inside this repo, always resolve `pi` from the project-local install
# so behavior is deterministic and independent from global npm/bun installs.

# direnv stdlib provides PATH_add; this prepends to PATH.
PATH_add node_modules/.bin

# Helpful pointer for scripts/debugging.
export PICLAW_LOCAL_PI_BIN="$PWD/node_modules/.bin/pi"
